{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/unified_candle.schema.json",
  "title": "Unified Candle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exchange",
    "symbol",
    "interval",
    "open_time_ms",
    "close_time_ms",
    "open",
    "high",
    "low",
    "close",
    "volume_base",
    "ingestion_time_ms"
  ],
  "properties": {
    "exchange": {
      "type": "string",
      "minLength": 1
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z0-9]+-[A-Z0-9]+$"
    },
    "interval": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(mon|m|h|d|w)$"
    },
    "open_time_ms": {
      "type": "integer",
      "minimum": 0
    },
    "close_time_ms": {
      "type": "integer",
      "minimum": 0
    },
    "open": {
      "type": "number"
    },
    "high": {
      "type": "number"
    },
    "low": {
      "type": "number"
    },
    "close": {
      "type": "number"
    },
    "volume_base": {
      "type": "number",
      "minimum": 0
    },
    "volume_quote": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "trade_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "ingestion_time_ms": {
      "type": "integer",
      "minimum": 0
    }
  }
}
